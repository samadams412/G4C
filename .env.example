# MySQL
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=eventify_db
MYSQL_USER=eventify_app
MYSQL_PASSWORD=change_me

# dev-only: host port mapping for db (set empty / remove service port mapping to disable)
DB_HOST_PORT=3306

# API
API_PORT=4000
JWT_SECRET=change_me

# Web
WEB_PORT=3000

# Dev-only seeded admin login (admin@eventify.dev). Used only to produce
# db/docker-init/01b-seed-admin.sql via `python seeds/seed_admin.py` — never
# used in production, never set this to a real password.
SEED_ADMIN_PASSWORD=ChangeMe123!

# Dev-only seeded non-admin test login (attendee@eventify.dev, role Attendee).
# Used only to produce db/docker-init/01c-seed-test-user.sql via
# `python seeds/seed_test_user.py` — never used in production.
SEED_TEST_USER_PASSWORD=ChangeMe123!
